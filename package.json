{
  "name": "path-pilot",
  "version": "1.0.0",
  "private": true,
  "description": "Student Career Guidance System — MEAN stack lab project",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev -w server\" \"npm start -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "seed": "npm run seed -w server",
    "create-admin": "npm run create-admin -w server",
    "test": "npm test -w server",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/performance.mjs",
    "db:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-database.ps1",
    "lab": "npm run db:start && npm run dev",
    "db:status": "node scripts/database-status.mjs",
    "share": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/share-cloudflare.ps1",
    "share:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/restart-cloud-app.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.58.0"
  }
}
