PORT=3001
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/path_pilot
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NODE_ENV=development
COOKIE_SECURE=false
ENABLE_EXTERNAL_QUIZZES=true
# Used only by explicit seed / create-admin commands:
# DEMO_PASSWORD=your-own-student-password
# ADMIN_EMAIL=admin@your-college.example
# ADMIN_PASSWORD=your-own-strong-password
# ADMIN_NAME=Administrator

# Premium plan demo: INR 499 for 30 days, one payment, no auto-renewal.
PREMIUM_PRICE_PAISE=49900
PREMIUM_DAYS=30
# Classroom demo: no account, PAN, or payment credentials required.
PAYMENT_MODE=simulation
# Set PAYMENT_MODE=razorpay to use Razorpay test checkout instead.
# In Razorpay mode, leave ALL three empty to disable checkout until configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
